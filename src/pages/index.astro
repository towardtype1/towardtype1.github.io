---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import InstrumentPanel from '../components/InstrumentPanel.astro';
import SiteNav from '../components/SiteNav.astro';
import { memoNumbers } from '../lib/memo';
import { SITE_TITLE, TAGLINE } from '../consts';

const essays = await getCollection('essays');
const memos = memoNumbers(essays.map((e) => ({ id: e.id, date: e.data.date })));
const sorted = [...essays].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || b.id.localeCompare(a.id),
);
const latest = sorted[0];
---

<Base title={SITE_TITLE} description={TAGLINE}>
  <main>
    <SiteNav current="home" />
    <header class="masthead">
      <h1>{SITE_TITLE}</h1>
      <p class="tagline">{TAGLINE}</p>
    </header>
    <InstrumentPanel />
    {
      latest && (
        <p class="latest">
          <span class="latest-label">Latest transmission</span>
          <a href={`/essays/${latest.id}/`}>
            {memos.get(latest.id)} · {latest.data.title}
          </a>
          <span class="latest-date">{latest.data.date.toISOString().slice(0, 10)}</span>
          <a class="latest-all" href="/essays/">All essays</a>
        </p>
      )
    }
  </main>
</Base>
