---
import { ENERGY_DATA } from '../data/energy';
import { COMPUTE_DATA } from '../data/compute';
import { currentPowerWatts, joulesToday, kardashev, progressToType1 } from '../lib/energy';
import {
  computeProgress,
  currentAiFlops,
  flopToday,
  sciParts,
  type1ComputeEtaYear,
  type1ComputeFlops,
} from '../lib/compute';

const now = new Date();
const fmt = new Intl.NumberFormat('en-US');

const watts = currentPowerWatts(now);
const initialJoules = fmt.format(Math.round(joulesToday(now)));
const initialTw = (watts / 1e12).toFixed(2);
const initialK = kardashev(watts).toFixed(4);
const initialTwShort = (watts / 1e12).toFixed(1) + ' TW';
const initialPct = (progressToType1(watts) * 100).toFixed(3) + '%';

const flops = currentAiFlops(now);
const sci = sciParts(flopToday(now));
const capacityExp = Math.log10(flops).toFixed(1);
const budgetSci = sciParts(type1ComputeFlops());
const budgetMantissa = Number(budgetSci.mantissa).toFixed(1);
const budgetExp = budgetSci.exponent;
const computePctValue = computeProgress(flops) * 100;
const computePct = computePctValue.toPrecision(1) + '%';
const etaYear = type1ComputeEtaYear();
---

<div class="energy-panel">
  <p class="section-title"><span class="axis">01</span> Energy</p>
  <p class="label">Energy produced today · local</p>
  <div class="odometer"><span data-joules>{initialJoules}</span> <span class="unit">J</span></div>
  <div class="row">
    <div class="cell">
      <p class="label">Output</p>
      <div class="value"><span data-tw>{initialTw}</span> TW</div>
    </div>
    <div class="cell">
      <p class="label">Kardashev rating</p>
      <div class="value">K = <span data-k>{initialK}</span></div>
    </div>
    <div class="cell">
      <p class="label">Type 1 target</p>
      <div class="value">10¹⁶ W</div>
    </div>
  </div>
  <div class="gauge">
    <div class="gauge-head">
      <p class="label">Progress to Type 1</p>
      <span class="reading"><span data-tw-short>{initialTwShort}</span> / 10,000 TW · <span class="pct" data-pct>{initialPct}</span></span>
    </div>
    <div class="track"><div class="fill" data-fill style={`width: ${initialPct}`}></div></div>
    <div class="scale"><span>Type 0</span><span>Planetary budget · Type 1</span></div>
  </div>
  <p class="caption">{ENERGY_DATA.sourceLabel}</p>

  <hr class="section-break" />

  <p class="section-title"><span class="axis">02</span> Compute</p>
  <p class="label">Compute performed today · local</p>
  <div class="odometer"><span data-flop-mantissa>{sci.mantissa}</span> × 10<sup data-flop-exp>{sci.exponent}</sup> <span class="unit">FLOP</span></div>
  <div class="row">
    <div class="cell">
      <p class="label">Capacity</p>
      <div class="value">10<sup data-cap-exp>{capacityExp}</sup> FLOP/s</div>
    </div>
    <div class="cell">
      <p class="label">Type 1 budget</p>
      <div class="value">{budgetMantissa} × 10<sup>{budgetExp}</sup> FLOP/s</div>
    </div>
    <div class="cell">
      <p class="label">At current growth</p>
      <div class="value">Type 1 ≈ {etaYear}</div>
    </div>
  </div>
  <div class="gauge">
    <div class="gauge-head">
      <p class="label">Progress to Type 1 compute</p>
      <span class="reading">10<sup data-cap-exp2>{capacityExp}</sup> / {budgetMantissa} × 10<sup>{budgetExp}</sup> FLOP/s · <span class="pct" data-compute-pct>{computePct}</span></span>
    </div>
    <div class="track"><div class="fill" data-compute-fill style={`width: ${computePctValue}%`}></div></div>
    <div class="scale"><span>Type 0</span><span>Planetary energy budget as compute · Type 1</span></div>
  </div>
  <p class="caption">{COMPUTE_DATA.sourceLabel}</p>
</div>

<script>
  import { currentPowerWatts, joulesToday, kardashev, progressToType1 } from '../lib/energy';
  import { computeProgress, currentAiFlops, flopToday, sciParts } from '../lib/compute';

  const joulesEl = document.querySelector('[data-joules]')!;
  const twEl = document.querySelector('[data-tw]')!;
  const kEl = document.querySelector('[data-k]')!;
  const twShortEl = document.querySelector('[data-tw-short]')!;
  const pctEl = document.querySelector('[data-pct]')!;
  const fillEl = document.querySelector<HTMLElement>('[data-fill]')!;
  const flopMantissaEl = document.querySelector('[data-flop-mantissa]')!;
  const flopExpEl = document.querySelector('[data-flop-exp]')!;
  const capExpEl = document.querySelector('[data-cap-exp]')!;
  const capExp2El = document.querySelector('[data-cap-exp2]')!;
  const computePctEl = document.querySelector('[data-compute-pct]')!;
  const computeFillEl = document.querySelector<HTMLElement>('[data-compute-fill]')!;
  const fmt = new Intl.NumberFormat('en-US');

  function tick() {
    const now = new Date();

    const watts = currentPowerWatts(now);
    const pct = (progressToType1(watts) * 100).toFixed(3) + '%';
    joulesEl.textContent = fmt.format(Math.round(joulesToday(now)));
    twEl.textContent = (watts / 1e12).toFixed(2);
    kEl.textContent = kardashev(watts).toFixed(4);
    twShortEl.textContent = (watts / 1e12).toFixed(1) + ' TW';
    pctEl.textContent = pct;
    fillEl.style.width = pct;

    const flops = currentAiFlops(now);
    const sci = sciParts(flopToday(now));
    flopMantissaEl.textContent = sci.mantissa;
    flopExpEl.textContent = String(sci.exponent);
    const capExp = Math.log10(flops).toFixed(1);
    capExpEl.textContent = capExp;
    capExp2El.textContent = capExp;
    const cPct = computeProgress(flops) * 100;
    computePctEl.textContent = cPct.toPrecision(1) + '%';
    computeFillEl.style.width = cPct + '%';
  }

  tick();
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  setInterval(tick, reduced ? 1000 : 150);
</script>
