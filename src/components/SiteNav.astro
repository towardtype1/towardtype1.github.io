---
interface Props {
  current: 'home' | 'essays';
}

const { current } = Astro.props;
---

<nav class="site-nav">
  <a href="/" class:list={[{ active: current === 'home' }]} aria-current={current === 'home' ? 'page' : undefined}>Home</a>
  <a href="/essays/" class:list={[{ active: current === 'essays' }]} aria-current={current === 'essays' ? 'page' : undefined}>Essays</a>
</nav>
